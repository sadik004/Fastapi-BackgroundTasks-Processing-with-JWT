# Database Configuration (SQLite by default, or PostgreSQL)
DATABASE_URL=sqlite:///sports_app.db
# DATABASE_URL=postgresql://user:password@localhost:5432/sports_db

# Security & JWT Secrets
JWT_SECRET_KEY=change-this-in-production-to-a-super-secret-random-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
OTP_EXPIRE_MINUTES=5

# SMTP Server Configuration
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=465
SMTP_USER=info@yourdomain.com
SMTP_PASSWORD=your_secure_smtp_password
EMAIL_FROM=info@yourdomain.com
